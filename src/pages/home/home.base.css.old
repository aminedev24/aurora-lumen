/* ==============================================================================
 * frontend/src/pages/home.base.css
 * Aurora Lumen Web Theme — Modular Imports
 * ============================================================================== */

@import url("https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800;900&display=swap");

/* Modular CSS imports */
@import "./styles/variables.css";
@import "./styles/responsive.css";
@import "./styles/topbar.css";
@import "./styles/typography.css";
@import "./styles/buttons.css";
@import "./styles/contact.css";
@import "./styles/footer.css";

.landing,
.support-page,
.about-page,
.help-page,
.contact-page,
.legal-page,
.products-page {
  /* Aurora Lumen color palette */
  --aurora-green: #0B8B2B;
  --aurora-blue: #1EAAF9;

  /* Light theme base */
  --bg: linear-gradient(180deg, #F8FBFD 0%, #E9F9FF 100%);
  --text: #0F172A;
  --muted: #475569;
  --primary: var(--aurora-blue);
  --accent-green: var(--aurora-green);
  --panel-bg: rgba(255, 255, 255, 0.85);
  --border: rgba(0, 0, 0, 0.08);
  --radius: 14px;

  background: var(--bg);
  color: var(--text);
  font-family: "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  min-height: var(--app-height, 100dvh);
  width: 100%;
  max-width: 100vw;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* -------------------------------------------------------------------------- */
/* TOP BAR (Public Site)                                                      */
/* -------------------------------------------------------------------------- */
.top-bar {
  width: 100%;
  max-width: 100vw;
  padding: 14px 0;
  background: color-mix(in srgb, var(--bg) 96%, transparent);
  position: sticky;
  top: 0;
  z-index: 2500;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}

body.dark .top-bar {
  background: rgba(13, 17, 23, 0.92);
  border-bottom-color: rgba(148, 163, 184, 0.24);
}

.top-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 48px;
  position: relative;
}
.top-bar .top-bar-inner {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 clamp(1rem, 3vw, 2.5rem);
  box-sizing: border-box;
}

.top-bar-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex: 0 0 auto;
}

.brand-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: inherit;
}

.brand-link:hover .brand-text {
  text-decoration: underline;
}

.aurora-wordmark {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.aurora-wordmark__logo {
  flex: 0 0 auto;
  display: block;
}

.aurora-wordmark__text {
  font-weight: 700;
  font-size: 1rem;
  line-height: 1;
  color: inherit;
}

.brand-text {
  font-weight: 800;
  font-size: 1.3rem;
  color: var(--primary);
}

.primary-nav {
  display: flex;
  align-items: center;
  gap: 18px;
  min-width: 0;
  flex: 1 1 auto;
  justify-content: center;
}

.primary-nav .nav-link {
  text-decoration: none;
  font-weight: 600;
  color: var(--text);
  transition: color 0.2s ease;
  white-space: nowrap;
}

.primary-nav .nav-link:hover {
  color: var(--primary);
}

.top-bar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-left: auto;
  flex: 0 0 auto;
}
.top-bar-auth {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
}
.top-bar-cta.logout {
  background: transparent;
  color: var(--primary);
  border: 1px solid color-mix(in srgb, var(--primary) 55%, transparent);
}
.top-bar-cta.logout:hover:not([disabled]) {
  background: color-mix(in srgb, var(--primary) 12%, transparent);
}
.top-bar-cta.logout[disabled] {
  opacity: 0.7;
  cursor: wait;
}
.top-bar-cta.profile {
  background: linear-gradient(135deg, var(--aurora-green), var(--primary));
}
body.dark .top-bar-cta.logout {
  color: #93c5fd;
  border-color: rgba(148, 163, 184, 0.35);
}
body.dark .top-bar-cta.logout:hover:not([disabled]) {
  background: rgba(148, 163, 184, 0.16);
}

.theme-btn {
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--text);
  cursor: pointer;
  font-size: 16px;
  padding: 4px 8px;
  transition: background 0.2s ease, color 0.2s ease, transform 0.12s ease;
}

.theme-btn:hover {
  background: var(--hover);
  color: var(--primary);
  transform: translateY(-1px);
}

.nav-toggle {
  display: none;
  align-items: center;
  gap: 6px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  border-radius: 999px;
  padding: 6px 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.nav-toggle:hover {
  background: var(--hover);
  color: var(--primary);
}

.top-bar-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 12px;
  border-radius: 8px;
  border: none;
  font-weight: 600;
  text-decoration: none;
  color: #fff;
  background: var(--primary);
  transition: transform 0.12s ease, background 0.2s ease, opacity 0.2s ease;
}

.top-bar-cta:hover {
  transform: translateY(-1px);
  opacity: 0.92;
}

.top-bar-cta.signup {
  background: var(--accent-green);
}

.top-bar-cta.login {
  background: var(--primary);
}

.top-bar-cta.plus {
  background: linear-gradient(135deg, #0b8b2b 0%, #1da1f2 100%);
  padding: 6px 18px;
  border-radius: 999px;
  box-shadow: 0 12px 24px rgba(14, 116, 144, 0.22);
}

.top-bar-cta.plus:hover {
  opacity: 1;
  transform: translateY(-1px);
  box-shadow: 0 16px 32px rgba(14, 116, 144, 0.28);
}

.top-bar-cta.plus:active {
  transform: translateY(0);
  box-shadow: 0 10px 18px rgba(14, 116, 144, 0.24);
}

.donor-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 6px;
  color: #f59e0b;
}

.donor-badge svg {
  width: 15px;
  height: 15px;
}

body.dark .donor-badge {
  color: #facc15;
}

.lang-switcher {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.lang-chip {
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  border-radius: 999px;
  padding: 4px 12px;
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.08em;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border 0.2s ease;
}

.lang-chip:hover,
.lang-chip:focus-visible {
  background: var(--hover);
  color: var(--primary);
  outline: none;
}

.lang-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 160px;
  background: var(--panel-bg);
  border: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
  border-radius: 12px;
  box-shadow: 0 16px 34px rgba(15, 23, 42, 0.22);
  display: flex;
  flex-direction: column;
  padding: 6px;
  z-index: 2600;
}

.lang-menu-item {
  border: none;
  background: transparent;
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  gap: 8px;
  padding: 6px 10px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.lang-menu-item .lang-menu-name {
  font-size: 0.85rem;
  color: var(--muted);
  font-weight: 500;
}

.lang-menu-item.active {
  color: var(--primary);
}

.lang-menu-item:hover {
  background: var(--hover);
}

@media (max-width: 1200px) {
  .nav-toggle {
    display: inline-flex;
  }

  .primary-nav {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 12px);
    background: var(--panel-bg);
    border: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
    border-radius: 16px;
    padding: 14px 18px;
    box-shadow: 0 24px 45px rgba(15, 23, 42, 0.2);
    flex-direction: column;
    gap: 12px;
    display: none;
    z-index: 2600;
  }

  .primary-nav.open {
    display: flex;
  }

  .top-bar-actions {
    gap: 10px;
    flex-wrap: wrap;
  }

  .top-bar-actions .top-bar-cta {
    padding: 6px 10px;
    font-size: 0.9rem;
  }
}

@media (max-width: 600px) {
  .top-bar-actions {
    justify-content: flex-start;
  }

  .lang-menu {
    left: 0;
    right: auto;
  }
}

/* ---------- CONTAINER ---------- */
.page-shell {
  width: 100%;
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 1.5rem;
  box-sizing: border-box;
}

/* ---------- TRANSITIONS ---------- */
.landing * {
  transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
}

/* ---------- TYPOGRAPHY ---------- */
.landing h1,
.landing h2,
.landing h3 {
  font-weight: 800;
  color: var(--aurora-green);
  letter-spacing: -0.01em;
}
.landing h1 {
  font-size: clamp(2rem, 4vw, 3rem);
}
.landing h2 {
  color: var(--aurora-blue);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
}
.landing p {
  color: var(--muted);
  line-height: 1.6;
}

/* ---------- BUTTONS ---------- */
.landing .hp-btn {
  border-radius: var(--radius);
  font-weight: 700;
  text-decoration: none;
  box-shadow: none;
}
.landing .hp-btn:hover {
  transform: translateY(-1px);
}
.landing .contact-form button {
  background: linear-gradient(135deg, var(--aurora-green), var(--aurora-blue));
  color: #fff;
  border: none;
  border-radius: var(--radius);
  padding: 0.75rem 1.5rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 8px 18px rgba(30, 170, 249, 0.18);
}
.landing .contact-form button:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 22px rgba(11, 139, 43, 0.25);
}

/* ---------- DARK MODE ---------- */
body.dark .landing,
body.dark .about-page,
body.dark .help-page,
body.dark .contact-page,
body.dark .legal-page {
  --bg: linear-gradient(180deg, #0D1116 0%, #18222F 100%);
  --text: #E5E7EB;
  --muted: #94A3B8;
  --panel-bg: rgba(16, 22, 30, 0.9);
  --border: rgba(255, 255, 255, 0.1);
  background: var(--bg);
  color: var(--text);
}

/* Dark mode headings and accents */
body.dark .landing h1,
body.dark .landing h2,
body.dark .landing h3 {
  color: var(--aurora-blue);
}
body.dark .landing a,
body.dark .landing p {
  color: var(--text);
}

/* ---------- HERO BACKGROUND ---------- */
.landing .landing-hero {
  background: radial-gradient(
      circle at 60% 40%,
      rgba(11, 139, 43, 0.18),
      transparent 70%
    ),
    radial-gradient(circle at 30% 80%, rgba(30, 170, 249, 0.18), transparent 60%),
    linear-gradient(180deg, #ffffff 0%, #f4fbff 100%);
}
body.dark .landing .landing-hero {
  background: radial-gradient(
      circle at 60% 40%,
      rgba(11, 139, 43, 0.22),
      transparent 70%
    ),
    radial-gradient(circle at 30% 80%, rgba(30, 170, 249, 0.25), transparent 60%),
    linear-gradient(180deg, #0e141a 0%, #121a24 100%);
}

/* ========================================================================== */
/* CONTACT PAGE — Aurora Lumen Luminous Design (Centered + Safari Support) */
/* ========================================================================== */

.contact-hero {
  text-align: center;
  padding: clamp(4rem, 8vw, 6rem) 1rem;
  background: radial-gradient(circle at 60% 40%, rgba(11, 139, 43, 0.18), transparent 70%),
              radial-gradient(circle at 30% 80%, rgba(30, 170, 249, 0.18), transparent 60%),
              linear-gradient(180deg, #ffffff 0%, #f4fbff 100%);
  color: var(--text);
}
body.dark .contact-hero {
  background: radial-gradient(circle at 60% 40%, rgba(11, 139, 43, 0.22), transparent 70%),
              radial-gradient(circle at 30% 80%, rgba(30, 170, 249, 0.25), transparent 60%),
              linear-gradient(180deg, #0e141a 0%, #121a24 100%);
}

.contact-hero h1 {
  font-size: clamp(2.2rem, 5vw, 3rem);
  font-weight: 800;
  background: linear-gradient(90deg, var(--aurora-green), var(--aurora-blue));
  -webkit-background-clip: text;
  color: transparent;
}

.contact-hero p {
  font-size: 1.1rem;
  color: var(--muted);
  margin-top: 0.75rem;
}

/* === Centered Glass Form Section (Full-Screen Centered + Safari Support) === */
.contact-body {
  position: relative;
  padding: 0 1rem;                 /* no vertical padding: we want hard centering */
  box-sizing: border-box;
  min-height: calc(100vh - 240px); /* viewport minus TopBar + Footer */
}

/* ⬇️ This is the key: center INSIDE the shell that wraps the form */
.contact-body .page-shell {
  display: flex;
  align-items: center;             /* vertical centering */
  justify-content: center;         /* horizontal centering */
  min-height: inherit;             /* use the computed min-height from parent */
}

/* Short viewports: let it scroll and keep some top space */
@media (max-height: 720px) {
  .contact-body .page-shell {
    align-items: flex-start;
    padding-top: 4rem;
    min-height: auto;
  }
}

.contact-form-glass {
  width: min(100%, 540px);
  background: linear-gradient(180deg, rgba(255,255,255,0.6), rgba(255,255,255,0.45));
  border: 1px solid var(--border);
  border-radius: 20px;
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  box-shadow: 0 12px 32px rgba(30,170,249,0.15);
  padding: clamp(2rem, 5vw, 3rem);
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  justify-content: center;
  align-items: stretch;
  margin: 0 auto;                  /* ensure center in shell */
}

body.dark .contact-form-glass {
  background: linear-gradient(180deg, rgba(18,22,30,0.88), rgba(16,20,26,0.82));
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  box-shadow: 0 20px 40px rgba(11,139,43,0.2);
}

.contact-form-glass h2 {
  margin: 0 0 0.5rem;
  text-align: center;
  font-weight: 700;
  background: linear-gradient(90deg, var(--aurora-green), var(--aurora-blue));
  -webkit-background-clip: text;
  color: transparent;
}

.contact-form-glass label {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  font-weight: 600;
  color: var(--text);
}

.contact-form-glass input,
.contact-form-glass textarea {
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 0.8rem 1rem;
  font-size: 1rem;
  color: var(--text);
  background: rgba(255,255,255,0.8);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

body.dark .contact-form-glass input,
body.dark .contact-form-glass textarea {
  background: rgba(20,24,32,0.85);
  color: #e5e7eb;
}

.contact-form-glass input:focus,
.contact-form-glass textarea:focus {
  border-color: var(--aurora-blue);
  box-shadow: 0 0 0 2px rgba(30,170,249,0.25);
  outline: none;
}

/* Error alert */
.contact-error {
  background: rgba(255, 99, 99, 0.1);
  border: 1px solid rgba(255, 99, 99, 0.25);
  color: #b91c1c;
  font-weight: 600;
  border-radius: 10px;
  padding: 0.6rem 0.8rem;
  text-align: center;
}

/* === Modal Overlay === */
.contact-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: fadeIn 0.3s ease forwards;
}

.contact-modal {
  position: relative;
  width: min(90%, 420px);
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  overflow: hidden;
  text-align: center;
  padding: 2rem;
  box-shadow: 0 0 40px rgba(30, 170, 249, 0.3);
  color: var(--text);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
}

body.dark .contact-modal {
  background: rgba(18, 22, 30, 0.75);
  color: #e5e7eb;
}

.contact-modal-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 30%, rgba(30, 170, 249, 0.35), rgba(11, 139, 43, 0.25));
  opacity: 0.6;
  z-index: 0;
}

.contact-modal-content {
  position: relative;
  z-index: 1;
}

.contact-modal-content h3 {
  font-size: 1.8rem;
  margin-bottom: 0.5rem;
  background: linear-gradient(90deg, var(--aurora-green), var(--aurora-blue));
  -webkit-background-clip: text;
  color: transparent;
}

.contact-modal-content p {
  font-size: 1.05rem;
  color: var(--text);
  opacity: 0.85;
}

/* Fade animation */
@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

/* Mobile responsiveness */
@media (max-width: 640px) {
  .contact-body {
    min-height: 65vh;
    padding: 2rem 1rem;
  }
  .contact-body .page-shell {
    align-items: flex-start;
    min-height: auto;
  }
  .contact-form-glass {
    width: 100%;
    padding: 1.5rem;
  }
}

/* ---------- FOOTER ---------- */
footer {
  width: 100%;
  max-width: 100vw;
  box-sizing: border-box;
  overflow-x: hidden;
  background: linear-gradient(180deg, #0D1116 0%, #121A22 100%);
  color: #94A3B8;
  padding: 3rem 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}
body:not(.dark) footer {
  background: linear-gradient(180deg, #F8FBFD 0%, #E9F9FF 100%);
  color: #334155;
  border-top: 1px solid rgba(0, 0, 0, 0.05);
}

@media (max-width: 768px) {
  footer {
    padding: 2.25rem 1rem;
  }
}

/* ---------- GLOBAL RESET ---------- */
html,
body {
  margin: 0;
  padding: 0;
  min-height: var(--app-height, 100dvh);
}

/* === Mobile Width Fix — prevents clipping on small screens === */
@media (max-width: 768px) {
  .landing,
  .support-page,
  .about-page,
  .help-page,
  .contact-page,
  .legal-page,
  .products-page {
    overflow-x: visible;
  }

  .page-shell,
  .hp-shell {
    max-width: 100vw;
    padding: 0 1rem;
  }
}

/* === iPhone Plus and smaller === */
@media (max-width: 414px) {
  .top-bar-inner {
    padding: 0 0.75rem;
  }

  .page-shell,
  .hp-shell {
    padding: 0 0.75rem;
  }

  /* Ensure buttons don't overflow */
  .hp-btn,
  .btn {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Tighter hero layout */
  .hp-hero-copy {
    padding: 0;
  }
}

/* === Global Horizontal Alignment Fix === */
html, body {
  overflow-x: hidden;
  width: 100%;
}

.landing,
.support-page,
.about-page,
.help-page,
.contact-page,
.legal-page,
.products-page {
  margin: 0 auto;
  left: 0;
  right: 0;
  position: relative;
  width: 100%;
  max-width: 100vw;
}
